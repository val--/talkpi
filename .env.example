# Ollama Configuration
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma3:1b

# Piper TTS Configuration (adjust paths to your system)
PIPER_BIN=/path/to/piper-venv/bin/piper
PIPER_MODEL=/path/to/piper-models/fr_FR-upmc-medium.onnx
PIPER_CONFIG=/path/to/piper-models/fr_FR-upmc-medium.onnx.json

# Whisper STT Configuration (adjust paths to your system)
WHISPER_BIN=/path/to/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/path/to/whisper.cpp/models/ggml-small.bin
WHISPER_LANGUAGE=fr

# Audio Settings
AUDIO_FORMAT=S16_LE
AUDIO_RATE=16000
AUDIO_CHANNELS=1
DEFAULT_RECORD_DURATION=7
